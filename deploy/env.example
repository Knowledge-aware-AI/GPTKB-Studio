# Example /etc/minigptkb/env (make it readable by root only: chmod 600).
# Key for the ScaDS.AI inference service: label embeddings, and model calls
# when users leave the API key field empty.
SCADS_API_KEY=
# Optional: where run folders are kept (default: runs/ in the app folder).
# MINIGPTKB_RUNS_DIR=/var/lib/minigptkb/runs
# Optional, for a public instance: minutes one run may use the shared key in
# total, and how many runs may use it at the same time (default: no limits).
# MINIGPTKB_SHARED_KEY_MINUTES=10
# MINIGPTKB_MAX_SHARED_KEY_RUNS=20
