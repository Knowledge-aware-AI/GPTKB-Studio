# Example /etc/gptkbstudio/env (make it readable by root only: chmod 600).
# The variable names keep the prefix of the project's former name, miniGPTKB.
# Key for the ScaDS.AI inference service: label embeddings, and model calls
# when users leave the API key field empty.
SCADS_API_KEY=
# Optional: where run folders are kept (default: runs/ in the app folder).
# MINIGPTKB_RUNS_DIR=/var/lib/gptkbstudio/runs
# Optional, for a public instance: minutes one run may use the shared key in
# total, and how many runs may use it at the same time (default: no limits).
# MINIGPTKB_SHARED_KEY_MINUTES=10
# MINIGPTKB_MAX_SHARED_KEY_RUNS=20
# Optional: a label shown in red under the app name, e.g. on an internal test instance.
# MINIGPTKB_SITE_LABEL=Sandbox
# Optional: allow model endpoints on private, loopback or link-local addresses
# (e.g. vLLM or Ollama on the same machine); refused by default.
# MINIGPTKB_ALLOW_PRIVATE_ENDPOINTS=1
